# Copy this file to .env.local for local development.
# Never commit real keys or tokens.

# Production URL used for OAuth callbacks.
NEXT_PUBLIC_APP_URL=https://fantasy-command-center-omega.vercel.app

# Google Sheets OAuth — read-only survivor pool integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use a long random value (32+ chars). This encrypts the Google refresh token cookie.
GOOGLE_TOKEN_SECRET=

# Yahoo Fantasy Sports API — OAuth plumbing is deployed but stays gated until Yahoo provisions Fantasy Sports access.
# Keep false until Yahoo confirms provisioning, then set true in the server environment.
YAHOO_FANTASY_ENABLED=false
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Register this exact redirect URI in the Yahoo Developer app.
YAHOO_REDIRECT_URI=https://fantasy-command-center-omega.vercel.app/api/yahoo/callback
# Use a long random value (32+ chars). This encrypts Yahoo OAuth tokens in the httpOnly session cookie.
YAHOO_TOKEN_SECRET=

# Web Push — public key is safe for the browser; private key stays server-only.
# Generate one VAPID keypair and keep it stable so existing device subscriptions remain valid.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:your-email@example.com

# Persistent push subscription storage.
# FFCC expects an Upstash Redis-compatible REST endpoint and token here.
PUSH_STORE_URL=
PUSH_STORE_TOKEN=

# Authenticates server/watcher calls to POST /api/push/send.
# Use a long random secret and never expose it to the browser.
FFCC_PUSH_SEND_TOKEN=

# Optional editorial/news layer (unused by default).
FANTASYPROS_API_KEY=
